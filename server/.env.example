# PostgreSQL credentials (match infra/.env)
DB_USER=postgres
DB_PASSWORD=bookland_secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookland

# Redis (use redis://localhost:6379 when running outside Docker)
REDIS_URL=redis://localhost:6379

# JWT secret for auth tokens (change in production!)
JWT_SECRET=change_me_in_production

# Express Backend Port
PORT=3001
