# PostgreSQL credentials (match infra/.env)
DB_USER=postgres
DB_PASSWORD=bookland_secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookland

# Redis (use redis://localhost:6379 when running outside Docker)
REDIS_URL=redis://localhost:6379

# JWT secret for auth tokens (generate with: openssl rand -base64 32)
# REQUIRED - no fallback, server will crash if missing
JWT_SECRET=your-super-secret-jwt-key-generate-with-openssl-rand-base64-32

# Express Backend Port
PORT=3001

# Node Environment
NODE_ENV=development

# Client URL for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100